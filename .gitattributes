# 统一换行符：源码/文档用 LF，Windows 脚本保持 CRLF 便于 PowerShell 5.1 直接运行
* text=auto
.gitattributes text eol=lf
.editorconfig text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.webp binary
*.jpg binary
*.ico binary
