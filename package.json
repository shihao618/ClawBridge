{
  "name": "clawbridge",
  "version": "1.0.2",
  "description": "ClawBridge - 多用户微信 ClawBot 扫码绑定与消息推送平台",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "mock": "node mock/ilink-mock.mjs",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\" \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node --test --test-reporter=spec \"tests/e2e/**/*.test.js\" \"tests/e2e/**/*.test.mjs\"",
    "e2e:stability": "node scripts/e2e-stability.mjs",
    "test:ui": "node scripts/frontend-smoke.mjs",
    "coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=85 --test-coverage-exclude=\"web/**\" --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "doc:lint": "node scripts/doc-lint.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "rotate-secret": "node scripts/rotate-app-secret.mjs",
    "smoke:mock": "node mock/selftest.mjs",
    "docker:build": "docker build -t clawbridge:local .",
    "docker:up": "docker compose up -d --build",
    "docker:demo": "docker compose -f docker-compose.yml -f docker-compose.demo.yml --profile demo up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
