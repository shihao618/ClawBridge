# =============================================================================
# ClawBridge 环境变量模板
#
# 用法：
#   cp .env.example .env            # Linux / macOS / Git Bash
#   Copy-Item .env.example .env    # Windows PowerShell
# 然后按需修改 APP_SECRET 等（.env 已被 .gitignore 忽略，不要提交到仓库）。
#
# 机密说明（docs/SETTINGS.md §8）：
#   - 管理密码 / API Token 只由数据库管理；首次启动（空 DB）自动生成随机值 →
#     DATA_DIR/admin-password.txt、DATA_DIR/api-token.txt（0600），并写入 DB（scrypt/AES）；
#   - 管理后台「安全」卡片可修改密码 / 重新生成 Token / 查看来源与脱敏预览；
#     重置会生成新随机值并同步更新上述文件，明文仅在操作响应中显示一次。
#
# 也可不创建 .env 直接启动：程序会自动生成随机密钥到 DATA_DIR（容器内 /app/data），
# 但 docker compose 要求 .env 文件存在（env_file），因此 Docker 部署请先复制本模板。
#
# =============================================================================
# 运行配置说明（docs/SETTINGS.md §7 第二批 + §8）
# =============================================================================
# 本文件中的参数分两类：
# 1) **必须由 .env 管理（后台只读/脱敏展示，不能在线改）——仅以下几项**：
#    APP_SECRET、DATA_DIR、MEDIA_DIR、PORT、HOST、NODE_ENV（以及容器/部署变量，如 TZ）。
# 2) **其余全部可在后台「运行配置」在线修改**（写入 DB、重启不丢失）；
#    本文件中这些值只是**首次启动默认值/回退值**：后台改过后以 DB 为准，
#    可在后台按分组「恢复默认」回到本文件/内置默认值。包括：
#    - 第三节 ILINK_*、第四节 BINDING_*、第五节推送/限流、第六节 MONITOR_*、
#      第七节 MEDIA_*、第九节 KEEPALIVE_*、第十节 APP_RULE*、第十一节 SCHEDULER_*；
#    - 第二批新增可后台分组：server（publicBaseUrl/trustProxy/cookieSecure/logLevel）、
#      security（sessionTtlMs/pushApiEnabled + 管理密码/API Token 后台管理）、ilink（协议地址/常量）、
#      monitor、media 扩展（MIME/超时/并发与白名单）、push.tickMs、binding 扩展（pollGapMs/networkErrorLimit）。
#    分组字段与生效方式见 docs/SETTINGS.md §7.2。
# 3) 管理密码 / API Token 只由 DB 管理；GET /api/admin/settings
#    永不回显明文/哈希，仅显示来源（恒为 db）与脱敏 preview。
# 4) 第八节「本地 demo」仅开发/演示使用，仍由 .env 管理。
# 5) 第十二节「数据维护」为进程级定时任务参数，当前仅由 .env 管理（后台暂无对应字段）。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、APP_SECRET（唯一必须由 .env 提供的机密：加密主密钥，不能存进被它加密的 DB）
# -----------------------------------------------------------------------------

# AES-256-GCM 主密钥（加密落库的 bot_token / context_token / API Token 密文；也用于管理会话 Cookie 签名）。
# 建议 32~64 位随机字符串（如 `openssl rand -hex 32`）。留空则自动生成 DATA_DIR/app-secret.key；
# 一旦启用请保持不变，否则重启后已有凭证无法解密（用户需重新扫码绑定）。
# 注意：APP_SECRET 是根密钥，**只由 .env 管理**，后台不可见/不可改。
APP_SECRET=


# -----------------------------------------------------------------------------
# 二、基础运行配置
#    **必须由 .env 管理**：PORT / HOST / DATA_DIR / MEDIA_DIR / NODE_ENV（DB 打开/进程启动前必须确定）。
#    其余（PUBLIC_BASE_URL / TRUST_PROXY / COOKIE_SECURE / LOG_LEVEL）为首次默认值，
#    可在后台「运行配置 → 服务」修改（trustProxy restartRequired，logLevel 即时）。
# -----------------------------------------------------------------------------

# HTTP 监听端口（Docker 内外一致，固定 10380；本地 npm start 也默认 10380）
PORT=10380

# 容器内监听地址（Docker 部署固定 0.0.0.0；本地调试可改 127.0.0.1）
# HOST=0.0.0.0

# 运行模式（production / development / test）。生产容器由 Dockerfile/Compose 注入，一般无需设置；
# 生产模式下后台「重启容器」等运维接口才可用（仅 .env）。
# NODE_ENV=production

# 数据目录（SQLite 数据库 + 自动生成的 secret/密码）。Docker 部署固定为 /app/data（命名卷 clawbridge-data）。
# 本地直接 `npm start` 时可保持默认 data。仅 .env。
DATA_DIR=/app/data

# 公网访问地址（可选；有反向代理/域名时填写，如 https://claw.example.com）。
# 影响页面展示与 Cookie Secure 判定（https 时自动 Secure）。可在后台运行配置修改。
PUBLIC_BASE_URL=

# 反向代理场景：是否信任 X-Forwarded-For / X-Forwarded-Proto（Nginx/Caddy 前置时设 true）。
# 可在后台运行配置修改（restartRequired）。
TRUST_PROXY=false

# HTTPS 反向代理时设 true，强制管理后台 Cookie 带 Secure（PUBLIC_BASE_URL 为 https 时自动开启）。
# 可在后台运行配置修改。
COOKIE_SECURE=false

# 日志级别：debug | info | warn | error | silent（生产建议 info）。
# 可在后台运行配置修改（即时生效）。
LOG_LEVEL=info

# SQLite synchronous 级别：NORMAL（默认，WAL 下性能与安全性平衡）| FULL（每次提交都 fsync，更保守但写入更慢）。
# 由 server/src/db.js 在打开数据库时直接读取，仅 .env；生产对断电安全性要求高时可设 FULL。
DB_SYNCHRONOUS=NORMAL

# 管理后台会话有效期（毫秒，默认 43200000 = 12 小时）。可在后台「运行配置 → 安全」修改（即时生效）。
# ADMIN_SESSION_TTL_MS=43200000

# -----------------------------------------------------------------------------
# 三、微信 iLink Bot 协议（首次启动默认值；可在后台「运行配置 → iLink」修改，
#    协议地址/常量在每次请求时实时读取，保存后**即时生效**（已建立的绑定会话基址不回溯）。
#    本地 mock 由 docker-compose.demo.yml 覆盖。ILINK_CDN_BASE_URL 见第七节媒体组。
# -----------------------------------------------------------------------------

# 登录 API 基址（get_bot_qrcode / get_qrcode_status 固定使用）
ILINK_LOGIN_BASE_URL=https://ilinkai.weixin.qq.com
# 绑定成功后的业务 API 基址（confirmed.baseurl 优先；默认同上）
ILINK_BASE_URL=https://ilinkai.weixin.qq.com

# 以下协议常量一般无需修改：
# ILINK_APP_ID=bot
# ILINK_CLIENT_VERSION=132106
# CHANNEL_VERSION=2.4.10
# BOT_AGENT=OpenClaw                 # 代码默认 OpenClaw（base_info.bot_agent，仅观测用途）；也可改为 ClawBridge/2.0.0
# ILINK_BOT_TYPE=3
# ILINK_ROUTE_TAG=                   # 可选 SKRouteTag 路由头；默认空 = 不发送
# ILINK_REQUEST_TIMEOUT_MS=15000
# ILINK_QR_POLL_TIMEOUT_MS=35000
# ILINK_LONGPOLL_TIMEOUT_MS=35000

# -----------------------------------------------------------------------------
# 四、绑定会话（★ 可在后台「运行配置」修改；以下为首次启动默认值）
# -----------------------------------------------------------------------------

# 单个绑定会话整体超时（默认 10 分钟）；二维码有效期约 5 分钟
# BINDING_TTL_MS=600000
# 二维码过期后最多自动刷新次数
# BINDING_MAX_REFRESHES=3
# 同时进行的绑定会话上限
# BINDING_MAX_ACTIVE=50
# 同一 IP 每小时可创建的绑定会话次数（防刷）
# BINDING_IP_LIMIT_PER_HOUR=20
# 等待手机确认（扫码后）的超时（毫秒，默认 120000 = 2 分钟）
# BINDING_VERIFY_TIMEOUT_MS=120000
# 绑定状态轮询连续网络错误上限（达到后本次绑定失败，默认 5）
# BINDING_NETWORK_ERROR_LIMIT=5
# 绑定状态轮询最小间隔（毫秒，默认 1000）
# BINDING_POLL_GAP_MS=1000

# -----------------------------------------------------------------------------
# 五、出站发送限流 / 队列（微信侧限制约 7 条 / 5 分钟 / 每个 bot 账号，保守默认即可）
# ★ 可在后台「运行配置 → 推送/限流」修改；以下为首次启动默认值。
# -----------------------------------------------------------------------------

# 每个 bot 账号在窗口期内最多发送条数
RATE_LIMIT_MAX=7
# 限流窗口（毫秒，默认 5 分钟）
RATE_LIMIT_WINDOW_MS=300000
# 队列最大重试次数
# PUSH_MAX_ATTEMPTS=5
# 失败重试退避序列（毫秒，逗号分隔；默认 5000,15000,30000,60000）。可在后台运行配置修改。
# PUSH_RETRY_DELAYS_MS=5000,15000,30000,60000
# dispatcher 循环间隔（毫秒）
# DISPATCH_TICK_MS=250
# 单条消息最大字符数（按 String.length 计）
# MAX_TEXT_LENGTH=4000
# 推送 API 每分钟每 Token 限流
# API_RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# 六、入站监控（首次启动默认值；可在后台「运行配置 → 入站监控」修改，restartRequired）
# -----------------------------------------------------------------------------

# 最多同时监控的 bot 账号数
# MONITOR_MAX_ACCOUNTS=200
# 入站长轮询超时（毫秒）
# MONITOR_LONGPOLL_TIMEOUT_MS=35000

# -----------------------------------------------------------------------------
# 七、多媒体（图片 / 视频 / 文件；协议与限制见 docs/MEDIA.md）
#    MEDIA_DIR 必须由 .env 管理（文件系统基础设施）；其余为首次启动默认值，
#    可在后台「运行配置 → 媒体」修改（大小上限/入站并发/排队上限 restartRequired；
#    超时/MIME 白名单/入站主机白名单/HTTP 放行即时生效）。
# -----------------------------------------------------------------------------

# 微信 CDN 基址（出站上传与入站下载均使用；真实环境保持默认；属 ilink.cdnBaseUrl，后台可改）。
# 本地 mock/demo 走 mock CDN 时改为 mock 服务地址 + /cdn 后缀（Docker demo：http://mock-ilink:3100/cdn）。
ILINK_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# 出站（发送）单文件上限（字节，默认 25MB）；超过返回 413
MEDIA_MAX_BYTES=26214400
# 入站（接收）单文件上限（字节，默认 100MB）；超过时记录附件失败但不影响消息入库
INBOUND_MEDIA_MAX_BYTES=104857600
# 入站下载并发上限（进程级信号量，默认 2；超出并发进入有界排队，防止整文件解密把进程内存打满）
INBOUND_MEDIA_MAX_CONCURRENT=2
# 入站下载排队上限（默认 64；0 = 不排队、超过并发直接记附件失败）
INBOUND_MEDIA_MAX_QUEUE=64
# 入站下载排队超时（毫秒，默认同 MEDIA_DOWNLOAD_TIMEOUT_MS；排队超时记附件失败）
INBOUND_MEDIA_QUEUE_TIMEOUT_MS=60000
# 入站媒体下载超时（毫秒，默认 60s）
MEDIA_DOWNLOAD_TIMEOUT_MS=60000
# 出站媒体上传超时（毫秒，默认 60s）
MEDIA_UPLOAD_TIMEOUT_MS=60000
# 允许按「图片」发送的 MIME 白名单（逗号分隔；未命中的按普通文件发送）
# MEDIA_ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/gif,image/webp,image/bmp
# 允许按「视频」发送的 MIME 白名单（逗号分隔；未命中的按普通文件发送）
# MEDIA_ALLOWED_VIDEO_MIME=video/mp4,video/quicktime,video/webm,video/x-matroska
# 入站媒体下载额外允许的主机白名单（逗号分隔；iLink/CDN 主机与 *.qq.com/*.weixin.qq.com 默认允许；
# dev/test 环境自动放行 localhost 以便对接 mock CDN，生产环境默认拒绝本机/私网地址）
# MEDIA_ALLOWED_HOSTS=media.example.com,cdn.example.com
# 允许入站媒体通过 http（非 https）下载（默认 false；白名单主机/本机例外；会降低 SSRF 防护强度）
# MEDIA_ALLOW_INSECURE_HTTP=false
# 媒体文件目录（默认 {DATA_DIR}/media，随命名卷持久化）。**仅 .env**：文件系统基础设施，后台只读展示。
# MEDIA_DIR=/app/data/media

# -----------------------------------------------------------------------------
# 八、本地 demo（仅 docker-compose.demo.yml 使用，真实部署无需关心；仅 .env）
# -----------------------------------------------------------------------------

# mock 二维码自动「扫码+确认」延迟（毫秒）；>0 生效，0 = 需手动调用控制面
MOCK_AUTO_CONFIRM_MS=3000
# mock 控制面在宿主机的端口（避免与本机 `node mock/ilink-mock.mjs` 的 3100 冲突时可改）
MOCK_PORT=3100

# -----------------------------------------------------------------------------
# 九、会话保活（24h 会话窗口；对开启了保活的用户自动发送保活消息）
# ★ 可在后台「运行配置 → 会话保活」修改；以下为首次启动默认值。
#
# 背景：微信 ClawBot 只有在用户最近一次给 bot 发消息后的约 24h 内才能可靠地主动下发消息。
# 本功能在「最后一条入站消息即将满 24h」时，自动给该用户发一条保活消息，提示其回复以刷新窗口。
#
# 注意：
# - 仅对管理员在后台/接口显式开启保活（opt-in）的用户/分组生效，默认不开启；
# - 每个会话窗口最多自动发送一次；用户回复（新的入站消息）后窗口重新计时，可再次触发；
# - 窗口已过期、从未有入站消息、账号冷却中的用户不会发送。
# - 保活消息走现有 outbox 队列（source=keepalive），受每账号限流与 -2/-14 处理逻辑约束。
# -----------------------------------------------------------------------------

# 全局调度开关：false = 完全不扫描（便于运维临时关闭；用户的 opt-in 设置保留）
KEEPALIVE_ENABLED=true
# 会话窗口长度（毫秒，默认 86400000 = 24h）；e2e/演示可调小
KEEPALIVE_WINDOW_MS=86400000
# 首次提前量（毫秒，默认 43200000 = 12h）：now - lastInboundAt >= windowMs - leadMs 时首次触发
KEEPALIVE_LEAD_MS=43200000
# 用户未回复时的重复提醒间隔（毫秒，默认 21600000 = 6h），直到窗口过期
KEEPALIVE_REPEAT_MS=21600000
# 扫描间隔（毫秒，默认 300000 = 5min）
KEEPALIVE_TICK_MS=300000
# 保活文本模板：支持 {name} 占位（渲染为绑定用户昵称）
KEEPALIVE_TEXT=【消息通道保活】回复任意内容即可继续接收通知。
# 单次扫描最多处理的用户数（防御上限，默认 100）
KEEPALIVE_MAX_PER_TICK=100

# -----------------------------------------------------------------------------
# 十、接口应用（关键词触发 → 调外部 HTTP 接口 → 解析回复微信；规则在管理后台配置）
# ★ 运行参数可在后台「运行配置 → 接口应用」修改（规则本身在后台接口应用页维护）；以下为首次默认值。
#
# 工作方式：用户消息命中规则关键词且范围（全部/指定用户/指定分组）匹配时，服务端按模板调用
# 配置的外部 HTTP 接口，解析响应后把结果自动回复给该微信用户（outbox source=rule）。
#
# 安全：
# - 默认**拒绝访问内网/本机地址**（SSRF 防护）；确需访问内网接口时，把目标主机加入
#   APP_RULES_ALLOWED_HOSTS 白名单（逗号分隔，仅白名单主机允许私网地址）；
# - 规则默认不启用：后台「接口应用」按需创建/开启；全局开关 false 时完全不触发；
# - 规则中的请求 Header 值加密落库，管理端只返回键名，不回显值。
# -----------------------------------------------------------------------------

# 规则引擎全局开关（false = 不触发，后台仍可管理规则）
APP_RULES_ENABLED=true
# 单次外部接口调用超时上限（毫秒，默认 8000；规则可配置更小，取二者较小值）
APP_RULE_TIMEOUT_MS=8000
# 外部接口响应体大小上限（字节，默认 1MB；超过直接判失败）
APP_RULE_MAX_RESPONSE_BYTES=1048576
# 规则执行并发数（默认 2）
APP_RULES_WORKER_CONCURRENCY=2
# 内网/本机访问白名单（逗号分隔主机名或 IP；为空 = 只允许公网地址，默认拒绝内网）
# 示例（本地联调外部接口 mock 时）：APP_RULES_ALLOWED_HOSTS=127.0.0.1,localhost
APP_RULES_ALLOWED_HOSTS=
# 内存队列上限（默认 200；超出丢弃并记录日志）
APP_RULE_MAX_QUEUE=200

# 规则调用外部接口期间向触发用户显示微信「正在输入」（默认开启；best-effort，失败不影响规则执行）
APP_RULE_TYPING_INDICATOR=true
# 「正在输入」刷新间隔（毫秒，默认 4000，范围 1000-30000；请求耗时较长时定期重发避免微信侧提前消失）
APP_RULE_TYPING_REFRESH_MS=4000

# -----------------------------------------------------------------------------
# 十一、定时通知（定时访问外部接口 → 解析返回 → 通过微信发给指定用户/分组）
# ★ 调度参数可在后台「运行配置 → 定时通知」修改（任务本身在后台定时通知页维护）；以下为首次默认值。
#
# 工作方式：后台「接口应用 → 定时通知」配置任务（间隔 / 每日定时；目标指定用户或分组；
# GET/POST + URL/Header/Body 模板；JSON 路径/文本响应；回复模板与兜底文案）。调度器在
# 服务进程内按时扫描（默认每 15s），到点执行一次 → 渲染通知文本 → 入队 outbox（source=schedule）
# → 由既有发送队列按微信限流投递（不绕过 7 条/5 分钟限流）。
#
# 注意：
# - 默认无任务（不影响现有功能）；任务停用后不再执行；
# - 调度为单实例：多副本部署时只让一个副本启用 SCHEDULER_ENABLED；
# - 每日任务按 SCHEDULER_TIMEZONE 解释 HH:mm；间隔任务从上次执行时间 + 间隔计算；
# - 外部接口默认拒绝内网/本机地址（复用接口应用 SSRF 防护；内网需 APP_RULES_ALLOWED_HOSTS 白名单）。
# -----------------------------------------------------------------------------

# 调度器全局开关（false = 不自动执行；后台仍可管理任务/测试运行/立即执行）
SCHEDULER_ENABLED=true
# 扫描间隔（毫秒，默认 15000 = 15s）
SCHEDULER_TICK_MS=15000
# 每日任务时区（IANA 名称，默认 Asia/Shanghai）
SCHEDULER_TIMEZONE=Asia/Shanghai
# 单次任务最多收件人数（默认 200；超出按用户 id 稳定排序截断并告警）
SCHEDULER_MAX_RECIPIENTS=200
# 单次外部请求超时上限（毫秒，默认 8000；任务可配更小）
SCHEDULER_TIMEOUT_MS=8000
# 定时通知外部响应体上限（字节，默认 0 = 继承接口应用 APP_RULES_MAX_RESPONSE_BYTES）
# SCHEDULER_MAX_RESPONSE_BYTES=0
# 定时通知允许访问的内网主机白名单（逗号分隔；默认空 = 继承 APP_RULES_ALLOWED_HOSTS）
# SCHEDULER_ALLOWED_HOSTS=
# 「按用户模式」单任务并发请求数（默认 2，范围 1-10；每个用户用自己的凭据请求）
SCHEDULER_PER_USER_CONCURRENCY=2
# 「按用户模式」单任务最多目标用户数（默认 50，范围 1-200；超出按用户 id 稳定排序截断）
SCHEDULER_PER_USER_MAX_RECIPIENTS=50

# -----------------------------------------------------------------------------
# 十二、数据维护（孤儿附件/磁盘文件清理、日志保留；进程级定时任务，默认启用）
#   说明：删除 outbox/inbound 业务数据；仅清理“无引用”的孤儿媒体与“超过保留期”的日志。
#   当前仅由 .env 管理（后台暂无对应字段）；设为 0 可关闭对应清理。
# -----------------------------------------------------------------------------

# 总开关（0 = 不启动定时维护；仍可手工调用 maintenance.runMaintenance）
# MAINTENANCE_ENABLED=1
# 启动后首次执行延迟（毫秒，默认 60000；0 = 立即）
# MAINTENANCE_INITIAL_DELAY_MS=60000
# 执行间隔（毫秒，默认 86400000 = 每天一次；最小 60000）
# MAINTENANCE_INTERVAL_MS=86400000
# 日志保留天数（events/app_rule_logs/scheduled_task_logs；默认 90，0 = 不清理）
# MAINTENANCE_LOG_RETENTION_DAYS=90
# 未入队的出站上传附件保留天数（默认 7，0 = 不清理）
# MAINTENANCE_UPLOAD_RETENTION_DAYS=7
# 单批删除/扫描上限（默认 200，1..1000；分批执行避免长事务）
# MAINTENANCE_BATCH_SIZE=200
# 孤儿文件最小年龄（毫秒，默认 3600000 = 1h；防止误删正在写入的文件）
# MAINTENANCE_ORPHAN_FILE_MIN_AGE_MS=3600000
# 维护后执行 PRAGMA optimize（默认 1）
# MAINTENANCE_PRAGMA_OPTIMIZE=1
# 维护后执行 WAL checkpoint(TRUNCATE)（默认 1）
# MAINTENANCE_WAL_CHECKPOINT=1

# -----------------------------------------------------------------------------
# 仅 fnOS（飞牛OS）Compose 可选变量
#   主 docker-compose.yml 使用命名卷，不读取以下变量；
#   docker-compose.fnos.yml 可用它们覆盖：运行用户、项目数据目录。
#   注意：./data 需提前创建并归对应 UID 所有（否则 Docker 自动创建会归 root，容器无法写入）。
# -----------------------------------------------------------------------------
# 容器运行 UID/GID（默认 1000:1000，即 fnOS 默认用户）
# PUID=1000
# PGID=1000
# 持久化数据目录（默认 ./data，可改为 /vol1/1000/docker/clawbridge/data 等绝对路径）
# DATA_PATH=./data




